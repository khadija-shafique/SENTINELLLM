# SentinelLLM Environment Variables
# Copy this file to .env and fill in your API keys.
# The backend works in DEMO mode without keys (returns simulated results).

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override database path (default: sentinellm.db in project root)
# DATABASE_PATH=sentinellm.db

# Optional: comma-separated CORS origins (default "*" for local dev)
# Production example: ALLOWED_ORIGINS=https://your-app.vercel.app
# ALLOWED_ORIGINS=*

# Optional: rate limit for cost-bearing endpoints (/scan, /evaluate)
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
